{
  "manifest_version": 3,
  "name": "Azure DevOps Docs Viewer",
  "version": "1.0.0",
  "description": "Renders Markdown and PlantUML files from Azure DevOps in a new tab.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://dev.azure.com/*"],
  "content_scripts": [
    {
      "matches": ["https://dev.azure.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["render-md.html", "render-puml.html", "render-openapi.html", "lib/marked.min.js", "lib/pako.min.js", "lib/js-yaml.min.js", "lib/swagger-ui-bundle.js", "lib/swagger-ui.css", "lib/swagger-ui-theme-flattop.css", "azure-fetch.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
